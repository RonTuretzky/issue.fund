[Unit]
Description=issue.fund restricted claim transaction signer
After=local-fs.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=issue-fund-signer
Group=issue-fund-ipc
WorkingDirectory=/opt/issue-fund/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/issue-fund/signer/service.env
ExecStart=/usr/bin/flock --nonblock --no-fork /var/lib/issue-fund-signer/process.lock /bin/sh -c 'rm -f /run/issue-fund-ipc/signer.sock; exec /usr/local/bin/node automation/run-signer.mjs'
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
UMask=0077
RuntimeDirectory=issue-fund-ipc
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/issue-fund-signer
MemoryMax=250M
TasksMax=32
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
