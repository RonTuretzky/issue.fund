[Unit]
Description=Verify online SQLite snapshots for issue.fund
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/issue-fund/current
ExecStart=/usr/local/bin/node automation/backup.mjs
UMask=0077
TimeoutStartSec=120
Nice=15
PrivateNetwork=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
ReadWritePaths=/var/backups/issue-fund
ReadOnlyPaths=/var/lib/issue-fund /var/lib/issue-fund-signer
