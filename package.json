{
  "name": "mergebounty",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node server/index.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "node --test tests/github.test.mjs tests/dkim.test.mjs",
    "test:contracts": "forge test -vv",
    "test:ui": "playwright test tests/browser/interface.spec.ts tests/browser/repositories.spec.ts tests/browser/direct-claim.spec.ts",
    "test:public-flow": "RUN_PUBLIC_FLOW=1 playwright test tests/browser/public-flow.spec.ts",
    "test:chain": "node --test tests/chain.test.mjs",
    "test:e2e": "playwright test",
    "chain": "anvil --host 127.0.0.1 --port 8547 --chain-id 31337 --gas-limit 30000000 --block-time 1 --silent",
    "deploy:local": "node scripts/deploy.mjs",
    "build:gnosis": "VITE_STATIC=true npm run build",
    "test:vectors": "node scripts/make-test-receipts.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "express": "5.1.0",
    "lucide-react": "0.468.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "viem": "2.56.3"
  },
  "overrides": {
    "ws": "^8.20.1",
    "underscore": "^1.13.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.63.0",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "vite": "6.4.3"
  }
}
